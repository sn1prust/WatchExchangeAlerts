# Copy this file to .env and fill it in. Never commit your .env.

SUBREDDIT=Watchexchange

# Comma-separated, case-insensitive, matched against post titles.
# Numbers match exactly ("74033" won't match "740331").
# Use "+" to require several terms in the same title: tudor prince + two tone
# KEYWORDS and EXCLUDE apply on the next check after you save -- no restart needed.
KEYWORDS=74033,76213
# Comma-separated; skip titles containing any of these
EXCLUDE=

# How often to check, in seconds. Minimum 60; 120+ recommended.
POLL_SECONDS=120

# Reddit asks every client to identify itself with a unique User-Agent that
# includes your Reddit username.
USER_AGENT=python:watchexchange-alerts:v1.0 (by /u/YOUR_REDDIT_USERNAME)

# ---- Reddit API (recommended) ----
# Create a "script" app at https://www.reddit.com/prefs/apps and paste its id/secret.
# Without these, the bot reads the subreddit's public RSS feed instead.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ---- Notifications (fill in one or more) ----

# ntfy (free): install the ntfy app and subscribe to this topic.
# Pick a long random name -- anyone who knows it can read your alerts.
NTFY_TOPIC=

# Telegram (free): create a bot with @BotFather, message it once, then get your
# chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord (free): Server Settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=

# Email, or your carrier's email-to-SMS gateway (free but unreliable).
# For Gmail, SMTP_PASSWORD must be an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=

# Set to 1 to be alerted about matching posts that already exist when the bot first starts
NOTIFY_ON_FIRST_RUN=0
